---
import type { HTMLAttributes } from "astro/types";
import { buttonVariants, type Variant, type Size } from "./button-variants";

interface Props extends HTMLAttributes<"button"> {
  variant?: Variant;
  size?: Size;
}

const { variant, size, class: className, ...rest } = Astro.props;
---

<button class={buttonVariants({ variant, size, class: className })} {...rest}>
  <slot />
</button>
