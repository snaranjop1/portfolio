---
import Box from "../components/Box.astro";
import { t, type Lang } from "../i18n";
interface Props {
  locale: Lang;
  class: string;
}

const { class: className, locale } = Astro.props;
const copy = t(locale).presentation;

const presentation = copy.text.replace(
  /<companylink>(.*?)<\/companylink>/g,
  '<a href="https://yipitdata.com" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 text-foreground hover:text-primary">$1</a>',
);
---

<Box class={className}>
  <p class="leading-relaxed text-sm pt-6" set:html={presentation} />
</Box>
